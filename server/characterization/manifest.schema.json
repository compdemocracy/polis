{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:polis:characterization:manifest:1",
  "type": "object",
  "required": [
    "version",
    "inventoryHash",
    "inventorySourceHash",
    "appCommit",
    "appSourceHash",
    "stackDigest",
    "stack",
    "schemaHash",
    "migrationVersion",
    "seed",
    "profile",
    "scopeHash",
    "normalizationHash",
    "corpusHash",
    "inputsHash",
    "caseCount",
    "blockingFailures",
    "coverage"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "caseCount": {
      "type": "integer",
      "minimum": 1
    },
    "blockingFailures": {
      "type": "integer",
      "minimum": 0
    },
    "inventoryHash": {
      "type": "string",
      "minLength": 1
    },
    "inventorySourceHash": {
      "type": "string",
      "minLength": 1
    },
    "appCommit": {
      "type": "string",
      "minLength": 1
    },
    "appSourceHash": {
      "type": "string",
      "minLength": 1
    },
    "stackDigest": {
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "type": "object"
    },
    "schemaHash": {
      "type": "string",
      "minLength": 1
    },
    "migrationVersion": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "scopeHash": {
      "type": "string",
      "minLength": 1
    },
    "normalizationHash": {
      "type": "string",
      "minLength": 1
    },
    "corpusHash": {
      "type": "string",
      "minLength": 1
    },
    "inputsHash": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
