{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "client-error/1",
  "$comment": "Generated by `npm run contract:generate` in server/ from server/src/contracts/*.ts. Do not edit; edit the TypeBox source and regenerate.",
  "title": "ClientError",
  "description": "POST /api/v3/clientErrors: bounded, privacy-projected browser diagnostics. Count is the new occurrences since the previous transmission; signature is recomputed by the receiver. Nonnetwork events have an empty method and zero status and duration_ms.",
  "type": "object",
  "properties": {
    "client": {
      "anyOf": [
        { "type": "string", "const": "alpha" },
        { "type": "string", "const": "admin" },
        { "type": "string", "const": "report" },
        { "type": "string", "const": "participation" }
      ]
    },
    "build": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64}|unknown)$" },
    "page": { "type": "string", "maxLength": 160 },
    "kind": {
      "anyOf": [
        { "type": "string", "const": "error" },
        { "type": "string", "const": "unhandledrejection" },
        { "type": "string", "const": "console_error" },
        { "type": "string", "const": "console_warn" },
        { "type": "string", "const": "fetch" },
        { "type": "string", "const": "xhr" },
        { "type": "string", "const": "resource" },
        { "type": "string", "const": "csp" }
      ]
    },
    "message": { "type": "string", "maxLength": 256 },
    "stack": { "type": "string", "maxLength": 1024 },
    "resource": { "type": "string", "maxLength": 160 },
    "method": {
      "anyOf": [
        { "type": "string", "const": "" },
        { "type": "string", "const": "GET" },
        { "type": "string", "const": "HEAD" },
        { "type": "string", "const": "POST" },
        { "type": "string", "const": "PUT" },
        { "type": "string", "const": "PATCH" },
        { "type": "string", "const": "DELETE" },
        { "type": "string", "const": "OPTIONS" },
        { "type": "string", "const": "CONNECT" },
        { "type": "string", "const": "TRACE" }
      ]
    },
    "status": { "type": "integer", "minimum": 0, "maximum": 599 },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "signature": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "count": { "type": "integer", "minimum": 1, "maximum": 1000 }
  },
  "required": [
    "client",
    "build",
    "page",
    "kind",
    "message",
    "stack",
    "resource",
    "method",
    "status",
    "duration_ms",
    "signature",
    "count"
  ],
  "additionalProperties": false
}
