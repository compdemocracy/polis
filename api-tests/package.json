{
  "name": "polis-api-tests",
  "version": "1.0.0",
  "description": "External test suite for Polis API",
  "type": "module",
  "scripts": {
    "test": "source test-env.sh && jest --detectOpenHandles",
    "test:debug": "DEBUG_API_CONTAINER=true DEBUG_API_REQUESTS=true npm test",
    "test:watch": "source test-env.sh && jest --watch",
    "test:coverage": "source test-env.sh && jest --coverage",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "lint:unsafe": "biome lint --write --unsafe",
    "check": "biome check --max-diagnostics=none"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@faker-js/faker": "^9.2.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "json-schema": "^0.4.0",
    "nock": "^13.5.6",
    "node-pg-migrate": "^7.8.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.15.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1"
  }
}
