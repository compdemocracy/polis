{
  "name": "polis-math-worker-cdk",
  "version": "1.0.0",
  "description": "CDK app to manage Polis math worker instances",
  "bin": {
    "math-worker": "bin/math-worker.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:integration": "SKIP_INTEGRATION_TESTS=false jest --testMatch='**/*.integration.test.ts'",
    "test:unit": "jest --testMatch='!**/*.integration.test.ts'",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.746.0",
    "@aws-sdk/client-ec2": "^3.749.0",
    "@aws-sdk/client-ssm": "^3.749.0",
    "aws-cdk-lib": "^2.178.2",
    "commander": "^11.0.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.19",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
