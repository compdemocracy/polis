{
  "/etc/polis-shadow/shadow.env": "# Non-secret constants for the light shadow. Written by user data.
REGION=us-east-1
REGISTRY=111111111111.dkr.ecr.us-east-1.amazonaws.com
IMAGE=111111111111.dkr.ecr.us-east-1.amazonaws.com/polis/math-python@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ENGINE_COMMIT=057bd9dc11f7385262d37821bdb81a8f21fdfdd4
MATH_ENV=python-shadow
DATABASE_SSL_MODE=require
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111111111111:secret:public-fixture-db-AbCdEf
DB_EXPECTED_HOST=public-fixture-primary.abc.us-east-1.rds.amazonaws.com
LOG_GROUP=/polis/light-shadow/math
RUN_PARAMETER=/polis/light-shadow/run
POLL_ALLOWLIST=
",
  "/etc/systemd/system/polis-math-shadow.service": "[Unit]
Description=Polis Python math poller, light shadow (MATH_ENV=python-shadow)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
Environment=HOME=/root DOCKER_CONFIG=/root/.docker
ExecCondition=/usr/local/bin/polis-math-shadow-enabled
ExecStart=/usr/local/bin/polis-math-shadow-start
ExecStop=/usr/bin/docker stop --time 60 polis-math-shadow
Restart=on-failure
RestartSec=60
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
