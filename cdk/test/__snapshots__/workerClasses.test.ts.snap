      "AlarmName": "Polis-DelphiClass-MissingWorker",
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "DatapointsToAlarm": 3,
      "EvaluationPeriods": 3,
      "Metrics": [
        {
          "Expression": "IF(instances >= 1 && FILL(heartbeat, 0) < 1, 1, 0)",
          "Id": "expr_1",
          "Label": "delphi instance up, no daemon heartbeat",
          "ReturnData": true,
        },
        {
          "Id": "instances",
          "MetricStat": {
            "Metric": {
              "Dimensions": [
                {
                  "Name": "AutoScalingGroupName",
                  "Value": {
                    "Ref": "AsgWorkerDelphiASGB84F6A99",
                  },
                },
              ],
              "MetricName": "GroupInServiceInstances",
              "Namespace": "AWS/AutoScaling",
            },
            "Period": 300,
            "Stat": "Maximum",
          },
          "ReturnData": false,
        },
        {
