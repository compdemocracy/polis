  "WorkerDelphiLongRunningAlarm": {
    "Properties": {
      "AlarmActions": [
        {
          "Ref": "AlarmTopicD01E77F9",
        },
      ],
      "AlarmDescription": "Queue class delphi: a worker has been in service for 6 hours. Cost guard: repeated firing is the evidence for a fixed resize instead of the autoscaled class.",
      "AlarmName": "Polis-DelphiClass-LongRunning",
      "ComparisonOperator": "GreaterThanOrEqualToThreshold",
      "DatapointsToAlarm": 72,
      "Dimensions": [
        {
          "Name": "AutoScalingGroupName",
          "Value": {
            "Ref": "AsgWorkerDelphiASGB84F6A99",
          },
        },
      ],
      "EvaluationPeriods": 72,
      "MetricName": "GroupInServiceInstances",
      "Namespace": "AWS/AutoScaling",
      "OKActions": [
        {
          "Ref": "AlarmTopicD01E77F9",
        },
      ],
      "Period": 300,
      "Statistic": "Maximum",
      "Threshold": 1,
      "TreatMissingData": "notBreaching",
    },
    "Type": "AWS::CloudWatch::Alarm",
  },
  "WorkerDelphiMissingWorkerAlarm": {
    "Properties": {
      "AlarmActions": [
        {
          "Ref": "AlarmTopicD01E77F9",
        },
      ],
