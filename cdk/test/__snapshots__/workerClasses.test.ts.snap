  "WorkerDelphiLaunchTemplate": {
    "DependsOn": [
      "WorkerDelphiInstanceRoleDefaultPolicy055F822B",
      "WorkerDelphiInstanceRole62FDA741",
    ],
    "Properties": {
      "LaunchTemplateData": {
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "DeleteOnTermination": true,
              "VolumeSize": 100,
              "VolumeType": "gp3",
            },
          },
        ],
        "IamInstanceProfile": {
          "Arn": {
            "Fn::GetAtt": [
              "WorkerDelphiLaunchTemplateProfile53F960AE",
              "Arn",
            ],
          },
        },
        "ImageId": {
          "Ref": "SsmParameterValueawsserviceamiamazonlinuxlatestal2023amikernel61x8664C96584B6F00A464EAD1953AFF4B05118Parameter",
        },
        "InstanceType": "r7i.2xlarge",
        "SecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "DelphiSecurityGroup53B17A30",
              "GroupId",
            ],
          },
        ],
        "TagSpecifications": [
          {
            "ResourceType": "instance",
            "Tags": [
              {
                "Key": "Name",
                "Value": "CdkStack/WorkerDelphiLaunchTemplate",
              },
            ],
          },
          {
            "ResourceType": "volume",
            "Tags": [
              {
                "Key": "Name",
                "Value": "CdkStack/WorkerDelphiLaunchTemplate",
              },
            ],
          },
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/bin/bash
#!/bin/bash
set -e
set -x
sudo mkdir -p /etc/app-info
sudo chown root:root /etc/app-info
sudo chmod 755 /etc/app-info
echo "Writing service type 'delphi-worker' to /etc/app-info/service_type.txt"
echo "delphi-worker" | sudo tee /etc/app-info/service_type.txt


echo "Writing queue worker class 'delphi' to /etc/app-info/worker_class.txt"
echo "delphi" | sudo tee /etc/app-info/worker_class.txt
echo "52g" | sudo tee /etc/app-info/worker_memory.txt
echo "polis-queue-login" | sudo tee /etc/app-info/queue_login_secret.txt
printf '%s=%s
' POLIS_JOBS_WORKER_CLASS "delphi" POLIS_JOBS_CONTAINER_MEMORY "52g" POLIS_JOBS_LOGIN_SECRET_NAME "polis-queue-login" POLIS_JOBS_IMAGE "123456789012.dkr.ecr.us-east-1.amazonaws.com/polis/delphi:latest" POLIS_JOBS_CA_FILE "/etc/polis-jobs/rds-ca-bundle.pem" POLIS_JOBS_HOST_ALLOWLIST "",
                {
                  "Fn::GetAtt": [
                    "DatabaseB269D8BB",
                    "Endpoint.Address",
                  ],
                },
                "" POLIS_JOBS_REQUIRE_SOURCE_COMMIT "0" | sudo tee /etc/app-info/polis-jobs.env
sudo chmod 644 /etc/app-info/polis-jobs.env
sudo yum update -y
sudo yum install -y amazon-cloudwatch-agent -y
sudo dnf install -y wget ruby docker
sudo systemctl start docker
sudo systemctl enable docker
sudo usermod -a -G docker ec2-user
sudo curl -L https://github.com/docker/compose/releases/download/v2.40.0/docker-compose-linux-$(uname -m) -o /usr/local/bin/docker-compose
sudo chmod +x /usr/local/bin/docker-compose
docker-compose --version
sudo yum install -y jq
export SERVICE=delphi-worker

echo "",
                {
                  "Ref": "LogGroupF5B46931",
                },
                "" | sudo tee /etc/app-info/log_group_name.txt
echo "Configuring CloudWatch Agent..."
aws s3 cp s3://cdk-hnb659fds-assets-123456789012-us-east-1/b0f3a98face9a32be47e361c9b6cdac568e47a2ca613d26c8779d512e17b6050.json /tmp/amazon-cloudwatch-agent.json || echo "CW agent config download failed; continuing"
sudo mkdir -p $(dirname /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json) || true
sudo mv /tmp/amazon-cloudwatch-agent.json /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json || true
sudo chmod 644 /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json || true
sudo chown root:root /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json || true
sudo systemctl enable amazon-cloudwatch-agent || true
sudo systemctl start amazon-cloudwatch-agent || echo "CW agent failed to start; continuing"
exec 1>>/var/log/user-data.log 2>&1
echo "Finished User Data Execution at $(date)"
sudo mkdir -p /etc/docker
cat << EOF | sudo tee /etc/docker/daemon.json
{
  "log-driver": "awslogs",
  "log-opts": {
    "awslogs-group": "",
                {
                  "Ref": "LogGroupF5B46931",
                },
                "",
    "awslogs-region": "us-east-1",
    "awslogs-stream": "delphi-worker"
  }
}
EOF
sudo chmod 644 /etc/docker/daemon.json
sudo systemctl restart docker
sudo systemctl status docker
cat << 'POLIS_JOBS_START' | sudo tee /usr/local/bin/polis-jobs-start
#!/bin/bash
# Starts the queue worker daemon with this box's class (written by the launch template).
set -euo pipefail
. /etc/app-info/polis-jobs.env
test -f /opt/polis/polis/.env  # the env document; the deploy writes it, systemd retries until then
umask 077
mkdir -p /run/polis-jobs /var/lib/polis-jobs/journal
if [ "\${POLIS_JOBS_REQUIRE_SOURCE_COMMIT:-0}" = 1 ]; then
  commit=$({ grep -E '^MATH_POLLER_SOURCE_COMMIT=' /opt/polis/polis/.env || true; } | tail -n 1 | cut -d= -f2-)
  if ! [[ "$commit" =~ ^[0-9a-f]{40}$ ]]; then
    echo "polis-jobs-start: refusing: no MATH_POLLER_SOURCE_COMMIT in /opt/polis/polis/.env (the deploy hook writes it)" >&2
    exit 1
  fi
fi
if [ ! -s "$POLIS_JOBS_CA_FILE" ]; then
  mkdir -p "$(dirname "$POLIS_JOBS_CA_FILE")"
  curl -fsS --retry 3 --max-time 60 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o "$POLIS_JOBS_CA_FILE.tmp"
  grep -q -- "-----BEGIN CERTIFICATE-----" "$POLIS_JOBS_CA_FILE.tmp"
  chmod 644 "$POLIS_JOBS_CA_FILE.tmp"
  mv "$POLIS_JOBS_CA_FILE.tmp" "$POLIS_JOBS_CA_FILE"
fi
aws secretsmanager get-secret-value --region us-east-1 --secret-id "$POLIS_JOBS_LOGIN_SECRET_NAME" --query SecretString --output text | jq -er .password > /run/polis-jobs/password
exec docker run --rm --name polis-jobs --memory "$POLIS_JOBS_CONTAINER_MEMORY" \\
  --env-file /opt/polis/polis/.env --env-file /etc/app-info/polis-jobs.env \\
  -e POLIS_JOBS_ENABLED=1 -e POLIS_JOBS_PASSWORD_FILE=/run/secrets/queue-login \\
  -e POLIS_JOBS_JOURNAL_DIR=/var/lib/polis-jobs/journal \\
  -v /run/polis-jobs/password:/run/secrets/queue-login:ro -v /var/lib/polis-jobs:/var/lib/polis-jobs \\
  -v "$POLIS_JOBS_CA_FILE:$POLIS_JOBS_CA_FILE:ro" \\
  "$POLIS_JOBS_IMAGE" polis-jobs
POLIS_JOBS_START
sudo chmod 755 /usr/local/bin/polis-jobs-start
cat << 'POLIS_JOBS_UNIT' | sudo tee /etc/systemd/system/polis-jobs.service
[Unit]
Description=Polis queue worker daemon (class in /etc/app-info/polis-jobs.env)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
[Service]
ExecStartPre=-/usr/bin/docker rm -f polis-jobs
ExecStart=/usr/local/bin/polis-jobs-start
ExecStop=/usr/bin/docker stop -t 900 polis-jobs
TimeoutStopSec=960
Restart=always
RestartSec=60
[Install]
WantedBy=multi-user.target
POLIS_JOBS_UNIT
sudo systemctl daemon-reload
sudo systemctl enable --now polis-jobs.service || echo "polis-jobs unit failed to start; it retries"",
