# Node's answer for a request polis-api could not take: the same upstream and
# settings as `location /`.
location @polis_node_api {
    proxy_pass http://server:${API_SERVER_PORT};
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_connect_timeout 300;
    proxy_send_timeout 300;
    proxy_read_timeout 300;
    proxy_buffering off;
    proxy_request_buffering off;
}
