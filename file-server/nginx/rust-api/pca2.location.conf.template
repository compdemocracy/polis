# GET /api/v3/math/pca2 to polis-api (RUST_API_ROUTES contains pca2). Any
# failure to get an answer from polis-api (no such host, refused, slower than
# the timeouts below, or its own 502 when its database is unreachable) is
# answered by Node instead.
location = /api/v3/math/pca2 {
    proxy_pass http://$polis_api_target;
    proxy_intercept_errors on;
    error_page 502 503 504 = @polis_node_api;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;
    proxy_buffering off;
    proxy_request_buffering off;
}
