# POST is read-only here. The process validates canonical bounded JSON; all
# other methods go straight to Node. No write route uses this location.
location = /api/v3/query_participants_by_metadata {
    error_page 418 = @polis_node_api;
    if ($request_method != POST) {
        return 418;
    }
    if ($http_transfer_encoding != "") {
        return 418;
    }
    # Buffer only the small canonical JSON slice so a 502 handoff can replay
    # the complete POST body. Larger/unknown-length inputs go straight to Node.
    if ($http_content_length !~ "^[1-9][0-9]{0,3}$") {
        return 418;
    }
    proxy_pass http://$polis_api_target;
    proxy_intercept_errors on;
    error_page 502 503 504 = @polis_node_api;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_connect_timeout 100ms;
    proxy_send_timeout 100ms;
    proxy_read_timeout 100ms;
    proxy_buffering off;
    proxy_request_buffering on;
}
