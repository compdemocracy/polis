
# Rendered only when RUST_API_ROUTES names a shadow (votesShadow). One line
# for each shadowed request as nginx answered it (Node's status and time, the
# participant's total time), and one for each copy (the shadow service's
# status and how long the copy held the connection). Both carry nginx's
# $request_id, which Node and the shadow receive as X-Request-Id; neither
# carries an address, a header value or a body.
log_format polis_shadow_edge escape=json '{"message":"shadow_edge","listener":"shadow","service":"nginx-proxy","route":"$request_method $uri","request_id":"$request_id","edge_status":$status,"edge_upstream_status":"$upstream_status","edge_upstream_s":"$upstream_response_time","edge_request_s":$request_time,"time":"$time_iso8601"}';
log_format polis_shadow_mirror escape=json '{"message":"shadow_mirror","listener":"shadow","service":"nginx-proxy","shadow":"$polis_shadow_name","request_id":"$request_id","mirror_status":$status,"mirror_upstream_status":"$upstream_status","mirror_s":$request_time,"time":"$time_iso8601"}';
# A shadowed request's ordinary access line: the ordinary format
# (polis_access, nginx-ssl.site.default.conf: the image's `main` with the
# request line written without its query string and the Referer without its
# query string and fragment) with its two address fields written "-": the
# first ($remote_addr, the peer) and the last (X-Forwarded-For; "-" is what
# that format itself writes for a request without that header). Both fields
# keep their place, so a reader of ordinary lines reads these too. A
# participant's address is in one of the two: in
# X-Forwarded-For behind a load balancer (which appends it), in the peer
# address where nginx faces participants directly. The shadow_edge line
# written beside this one carries the request id that joins Node's and the
# shadow's lines for the same request, so the access line of a shadowed
# request records neither. Every shadowed route's location writes this format
# (shadow-mirror.conf.template). The headers sent to Node and to the shadow
# are not changed. nginx's error log is not: a line it writes when the copy
# or Node fails names the peer as `client:` (it carries no request id).
log_format polis_shadow_access '- - $remote_user [$time_local] "$request_method $polis_log_path $server_protocol" $status $body_bytes_sent "$polis_log_referer" "$http_user_agent" "-"';

# Which requests a shadow is ever sent a copy of, and so which are handed to
# its mirroring location, the one that reads the whole body before Node is
# contacted: a POST whose body has a declared length, a Content-Length from 1
# to 9999, and is not chunked. Every other request to a shadowed path, any
# other POST included, never enters that location: it is proxied to Node
# exactly as with no shadow selected, its body streamed, with the ordinary
# access line and no X-Request-Id. The rule is the one the copy's own location
# applies, which is the vote write route's. The shadow service reads a body of
# up to 65536 bytes, so every request handed over is one it can read; and
# nginx holds a body of this size in memory (anything under a quarter more
# than its two-page buffer), so the mirror writes no temporary file.
map "$request_method:$http_content_length:$http_transfer_encoding" $polis_shadow_copyable {
    default 0;
    "~^POST:[1-9][0-9]{0,3}:$" 1;
}
