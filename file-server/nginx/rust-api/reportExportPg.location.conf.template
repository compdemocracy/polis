# Postgres-only report subtypes, off by default. External subtypes stay on Node.
location ~ ^/api/v3/reportExport/[^/]+/(?:format[.]json|summary[.]csv|comments[.]csv|votes[.]csv|participant-votes[.]csv|participant-importance[.]csv|comment-groups[.]csv)$ {
    error_page 418 = @polis_node_api;
    if ($polis_api_plain = 0) {
        return 418;
    }
    proxy_pass http://$polis_api_target;
    proxy_intercept_errors on;
    error_page 502 503 504 = @polis_node_api;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_connect_timeout 100ms;
    proxy_send_timeout 100ms;
    proxy_read_timeout 100ms;
    proxy_buffering off;
    proxy_request_buffering off;
}
