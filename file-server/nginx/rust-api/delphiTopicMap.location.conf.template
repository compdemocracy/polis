# GET and HEAD /api/v3/delphi/topicMap without a body go to polis-api
# (RUST_API_ROUTES contains delphiTopicMap); any other request on this path
# goes straight to Node (418 here is only an internal hand-over, never sent).
#
# A Rust-only route: Node has no handler for this path, so every hand-over to
# Node (a request polis-api does not model, stored rows it cannot read, its
# 502, or no answer in time) reaches Node's 404.
#
# Node also answers when polis-api gives no response: no such host, refused,
# or slower than the timeouts below before sending its status line. polis-api's
# 503 (the route shedding its own load: as many map reads in flight as it
# admits, its connections all in use, or its reads slower than its 3-second
# deadline; it carries Retry-After) is passed through to the client, as are
# its 500s. The read timeout is wider than the participation routes' because
# a run's map is found through its run record, which walks the job's
# publication history; polis-api answers or sheds within 3 seconds. This
# fallback covers failures BEFORE polis-api starts its response. Once its
# status line and headers have reached nginx, nginx cannot switch to Node: a
# response cut short after that reaches the client as a truncated reply
# (shorter than its Content-Length), which an HTTP client reports as a failed
# request.
#
# The requests that reach polis-api are bounded here, before it: at most 200
# a second for the whole location on this box, and 200 more at once (the zone,
# polis_topic_map, is in upstreams.conf). A request over the bound is answered
# by nginx itself and never reaches polis-api or Node: 503 with Retry-After: 1
# and the body polis-api sheds with (@polis_topic_map_over_bound below), so a
# page sees the same answer either way. It costs polis-api nothing, so a flood
# of map requests cannot take the CPU the participation routes need. 429 is
# only the internal hand-over to that location, never sent; polis-api never
# answers this route with 429. A request handed to Node above (not GET or
# HEAD, or with a body) is not counted: the limit runs after that hand-over.
location = /api/v3/delphi/topicMap {
    error_page 418 = @polis_node_api;
    if ($polis_api_plain = 0) {
        return 418;
    }
    limit_req zone=polis_topic_map burst=200 nodelay;
    limit_req_status 429;
    limit_req_log_level info;
    error_page 429 = @polis_topic_map_over_bound;
    proxy_pass http://$polis_api_target;
    proxy_intercept_errors on;
    error_page 502 504 = @polis_node_api;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_connect_timeout 100ms;
    proxy_send_timeout 100ms;
    proxy_read_timeout 5s;
    # A map is up to 1.5 MiB. nginx takes all of it from polis-api at once, in
    # memory and never a temporary file, so a slow reader holds nginx's
    # buffers, not polis-api's memory or its socket.
    proxy_buffering on;
    proxy_buffer_size 16k;
    proxy_buffers 32 64k;
    proxy_busy_buffers_size 128k;
    proxy_max_temp_file_size 0;
    proxy_request_buffering off;
}

# nginx's own answer to a map request over the bound: what polis-api answers
# when the route sheds its own load, status, headers and body. A refusal is
# kept out of the error log (limit_req_log_level info above), whose lines name
# the peer address.
location @polis_topic_map_over_bound {
    default_type application/json;
    add_header Retry-After 1 always;
    add_header Cache-Control no-store always;
    return 503 '{"status":"error","message":"polis_err_topic_map_busy"}';
}
