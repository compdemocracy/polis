  "metrics": {
    "V": {
      "definition": "full vote-event count: COUNT(*) over votes rows for the conversation, revotes included",
      "denominator": "n/a (a count)"
    },
    "U": {
      "definition": "distinct (pid, tid) cells: COUNT(DISTINCT (pid, tid)) over votes rows",
      "denominator": "n/a (a count)"
    },
    "P": {
      "definition": "distinct voting participants: COUNT(DISTINCT pid) over votes rows. This is the allocated-matrix-row count, NOT registered_participants.",
      "denominator": "n/a (a count)"
    },
    "C": {
      "definition": "comments referenced by votes: COUNT(DISTINCT tid) over votes rows",
      "denominator": "n/a (a count)"
    },
    "revote_share": {
      "definition": "(V - U) / V",
      "denominator": "V, the full vote-event count",
      "null_when": "V = 0"
    },
    "density": {
      "definition": "U / (P * C); pass votes count as observed cells, missing votes do not",
      "denominator": "matrix_area = P * C",
      "null_when": "P * C = 0"
    },
    "matrix_area": {
      "definition": "P * C",
      "denominator": "n/a (a product of counts)"
    },
    "mod_out_share": {
      "definition": "count of comments with mod = -1, divided by ALL comments of the conversation",
      "denominator": "all_comments (every row in comments for the conversation, moderated-out and meta included)",
      "null_when": "all_comments = 0"
    },
    "meta_share": {
      "definition": "count of comments with is_meta = true, divided by ALL comments of the conversation",
      "denominator": "all_comments (every row in comments for the conversation)",
      "null_when": "all_comments = 0"
    },
    "registered_participants": {
      "definition": "COUNT(*) over participants rows for the conversation; recorded for provenance only and never substituted for P",
      "denominator": "n/a (a count)"
    },
    "all_comments": {
      "definition": "COUNT(*) over comments rows for the conversation",
      "denominator": "n/a (a count)"
    },
    "math_eligible_comments": {
      "definition": "COUNT(*) over comments with mod <> -1 AND is_meta = false, matching the engine's mod-out rule (is_meta OR mod = -1 excludes a comment)",
      "denominator": "n/a (a count)"
    },
    "eligible_participants": {
      "definition": "COUNT(DISTINCT pid) over votes rows whose tid is a math-eligible comment; participant ban flags do NOT filter here, per the accepted removal of participant-ban filtering",
      "denominator": "n/a (a count)"
    },
    "banned_voters": {
      "definition": "COUNT(DISTINCT pid) over votes rows whose participant row has mod = -1",
      "denominator": "n/a (a count)"
    },
    "mod_out_or_meta_comments": {
      "definition": "COUNT(*) over comments with is_meta = true OR mod = -1, i.e. the engine's mod-out set; reported alongside mod_out_share so the two notions are never confused",
      "denominator": "n/a (a count)"
    },
    "zid": {
      "definition": "the conversation's numeric identifier; used ONLY as the final ascending tie-break inside the private selection process and never emitted publicly",
      "denominator": "n/a"
    }
  },
