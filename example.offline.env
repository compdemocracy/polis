# The offline profile's settings (docs/offline.md).
# Copy to offline.env, set OFFLINE_HOSTNAME, and run `make OFFLINE start`.
# Every endpoint below is on the box itself; nothing names a hosted service.
# Modelled on test.env, which runs the same production server build.

###### THE BOX ######
# The name participants' and admins' browsers use to reach the box
# (its LAN hostname or IP). The mkcert certificate must include it.
OFFLINE_HOSTNAME=localhost

###### DOCKER ######
TAG=offline
COMPOSE_PROJECT_NAME=polis-${TAG}
GIT_HASH=offline
POSTGRES_DOCKER=true
# Read by the Makefile; the offline target never adds local-services or ollama.
LOCAL_SERVICES_DOCKER=false
# true adds --profile offline-topics (delphi, ollama, dynamodb, minio).
OFFLINE_TOPICS=false

###### SERVER ######
NODE_ENV=production
# The production server build with plain-http host handling, as the test
# stack runs it. Also keeps the email notification loop off.
DEV_MODE=true
SERVER_LOG_LEVEL=info
ADMIN_UIDS=[]
API_DEV_HOSTNAME=${OFFLINE_HOSTNAME}
API_PROD_HOSTNAME=${OFFLINE_HOSTNAME}
DOMAIN_OVERRIDE=${OFFLINE_HOSTNAME}
EMBED_SERVICE_HOSTNAME=${OFFLINE_HOSTNAME}
SERVICE_URL=http://${OFFLINE_HOSTNAME}
STATIC_FILES_HOST=file-server
API_SERVER_PORT=5000
HTTP_PORT=80
HTTPS_PORT=443
STATIC_FILES_PORT=8080
SHOULD_USE_TRANSLATION_API=false
# Off: with no topic agenda the vote path never reads DynamoDB.
TOPICAL_COMMENT_RATIO=
# Unset: with OFFLINE=1 each email is logged (subject only) and not sent.
SES_ENDPOINT=
POLIS_FROM_ADDRESS=polis@offline.invalid
AWS_LOG_GROUP_NAME=
DD_APPLICATION_ID=
DD_CLIENT_TOKEN=
DD_SITE=
GA_TRACKING_ID=
LOGIN_CODE_PEPPER=change-this-on-the-box
WEBSERVER_USERNAME=ws-user
WEBSERVER_PASS=ws-pass

###### DATABASE ######
POSTGRES_DB=polis-offline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-on-the-box
DATABASE_URL=postgres://postgres:change-this-on-the-box@postgres:5432/polis-offline
DATABASE_SSL=false
DATABASE_SSL_MODE=disable
USE_PRODCLONE=false

###### MATH ######
# One label for the writer (math-python) and the readers (server, delphi).
MATH_ENV=python

###### LOCAL STORES (topic tier) ######
# Local endpoints even in the core tier, so no AWS client can fall back to AWS.
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_BUCKET_NAME=polis-delphi
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

###### LOCAL MODELS (topic tier) ######
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

###### ADMIN LOGIN (oidc-simulator, for now) ######
AUTH_AUDIENCE=users
AUTH_CERTS_PATH=~/.simulacrum/certs
AUTH_CLIENT_ID=dev-client-id
AUTH_CLIENT_SECRET=dev_auth-client_secret
AUTH_DOMAIN=${OFFLINE_HOSTNAME}:3000
AUTH_ISSUER=https://${OFFLINE_HOSTNAME}:3000/
AUTH_NAMESPACE=https://pol.is/
AUTH_SIMULATOR_PORT=3000
# Server-to-issuer, inside the compose network (the certificate names oidc-simulator).
JWKS_URI=https://oidc-simulator:3000/.well-known/jwks.json
OIDC_CACHE_KEY_ID_TOKEN_SUFFIX=@@user@@
OIDC_CACHE_KEY_PREFIX=oidc.user

###### PARTICIPANT TOKENS ######
# Keys from `make generate-jwt-keys`, mounted at /app/keys.
AUTH_KEYS_PATH=./server/keys
JWT_PRIVATE_KEY_PATH=/app/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt-public.pem
POLIS_JWT_AUDIENCE=participants
POLIS_JWT_ISSUER=https://pol.is/

###### CLIENT PARTICIPATION ALPHA ######
INTERNAL_SERVICE_URL=http://server:5000/api/v3
PUBLIC_SERVICE_URL=http://${OFFLINE_HOSTNAME}/api/v3
