{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pca2/1",
  "$comment": "Generated by `npm run contract:generate` in server/ from server/src/contracts/*.ts. Do not edit; edit the TypeBox source and regenerate.",
  "title": "Pca2",
  "description": "GET /api/v3/math/pca2 response body (full document). A response filtered with ?keys= carries a subset of these properties with the same types (Pca2Subset).",
  "type": "object",
  "properties": {
    "group-clusters": {
      "type": "array",
      "items": {
        "title": "Pca2GroupCluster",
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "members": {
            "description": "Base-cluster ids, not participant ids.",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "id",
          "center",
          "members"
        ]
      }
    },
    "base-clusters": {
      "title": "Pca2BaseClusters",
      "type": "object",
      "properties": {
        "x": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "y": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "id": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "count": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "members": {
          "description": "One array of participant ids per base cluster.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "x",
        "y",
        "id",
        "count",
        "members"
      ]
    },
    "group-votes": {
      "title": "Pca2GroupVotes",
      "description": "Keyed by group id.",
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "title": "Pca2GroupVoteEntry",
          "type": "object",
          "properties": {
            "votes": {
              "description": "Keyed by tid.",
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "title": "Pca2VoteCounts",
                  "type": "object",
                  "properties": {
                    "A": {
                      "description": "Agree votes.",
                      "type": "number"
                    },
                    "D": {
                      "description": "Disagree votes.",
                      "type": "number"
                    },
                    "S": {
                      "description": "Seen: every vote cast on the comment by the group, agree, disagree and pass.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "A",
                    "D",
                    "S"
                  ]
                }
              }
            },
            "n-members": {
              "type": "number"
            }
          },
          "required": [
            "votes"
          ]
        }
      }
    },
    "group-aware-consensus": {
      "description": "Keyed by tid.",
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "number"
        }
      }
    },
    "user-vote-counts": {
      "description": "Keyed by pid.",
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "number"
        }
      }
    },
    "in-conv": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "n-cmts": {
      "type": "number"
    },
    "n": {
      "type": "number"
    },
    "pca": {
      "title": "Pca2Pca",
      "type": "object",
      "properties": {
        "comps": {
          "description": "[dimension][participant].",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "comment-extremity": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "comment-projection": {}
      },
      "required": [
        "comps",
        "center",
        "comment-extremity",
        "comment-projection"
      ]
    },
    "tids": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "mod-in": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "mod-out": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "meta-tids": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "repness": {
      "title": "Pca2Repness",
      "description": "Representative comments, keyed by group id.",
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "array",
          "items": {
            "title": "Pca2RepnessEntry",
            "type": "object",
            "properties": {
              "tid": {
                "type": "number"
              },
              "repful-for": {
                "type": "string"
              },
              "p-success": {
                "type": "number"
              }
            },
            "required": [
              "tid"
            ]
          }
        }
      }
    },
    "consensus": {
      "title": "Pca2Consensus",
      "type": "object",
      "properties": {
        "agree": {
          "type": "array",
          "items": {
            "title": "Pca2ConsensusEntry",
            "type": "object",
            "properties": {
              "tid": {
                "type": "number"
              }
            },
            "required": [
              "tid"
            ]
          }
        },
        "disagree": {
          "type": "array",
          "items": {
            "title": "Pca2ConsensusEntry",
            "type": "object",
            "properties": {
              "tid": {
                "type": "number"
              }
            },
            "required": [
              "tid"
            ]
          }
        }
      },
      "required": [
        "agree",
        "disagree"
      ]
    },
    "votes-base": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    },
    "comment-priorities": {
      "description": "Keyed by tid.",
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "number"
        }
      }
    },
    "lastModTimestamp": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastVoteTimestamp": {
      "type": "number"
    },
    "math_tick": {
      "description": "The math generation, numeric in JSON. The math_env label is carried only in the ETag.",
      "type": "number"
    }
  },
  "required": [
    "group-clusters",
    "base-clusters",
    "user-vote-counts",
    "in-conv",
    "n-cmts",
    "n",
    "pca",
    "repness",
    "consensus",
    "math_tick"
  ]
}
